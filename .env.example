# 配置来源：local（只读本地 YAML）、nacos（只读 Nacos）、auto（本地文件存在时优先本地，否则 Nacos）。
FEEDBACK_CONFIG_SOURCE=local

# 本地 YAML 路径；不设置时默认为 ./config/config.yaml。
# FEEDBACK_CONFIG_FILE=./config/config.yaml

# 自定义 .env 路径；不设置时默认为项目根目录的 .env。
# FEEDBACK_ENV_FILE=.env

# 当 FEEDBACK_CONFIG_SOURCE 为 nacos 或 auto 且本地文件不存在时需要配置。
# NACOSDSN=127.0.0.1:8848?namespace=&username=nacos&password=nacos&group=DEFAULT_GROUP&dataId=feedback.yaml
